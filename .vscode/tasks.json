{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mini-OGAS: setup dev environment",
      "type": "shell",
      "command": ".\\scripts\\setup-dev.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Mini-OGAS: verify all",
      "type": "shell",
      "command": ".\\scripts\\verify-dev.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Mini-OGAS: start services",
      "type": "shell",
      "command": ".\\scripts\\start-all.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}\\services\\dashboard"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Central API: pytest",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}\\services\\central-api"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Node Agent: build",
      "type": "shell",
      "command": ".\\scripts\\build-node-agent.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
