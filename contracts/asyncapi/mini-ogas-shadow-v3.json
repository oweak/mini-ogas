{
  "asyncapi": "3.0.0",
  "channels": {
    "audit": {
      "address": "ogas.audit.{resource_type}",
      "messages": {
        "audit": {
          "$ref": "#/components/messages/Audit"
        }
      },
      "parameters": {
        "resource_type": {
          "description": "Validated audited resource token"
        }
      }
    },
    "commands": {
      "address": "ogas.commands.{node_code}",
      "messages": {
        "command": {
          "$ref": "#/components/messages/Command"
        }
      },
      "parameters": {
        "node_code": {
          "description": "Validated target node code"
        }
      }
    },
    "events": {
      "address": "ogas.events.{event_type}.{node_code}",
      "messages": {
        "event": {
          "$ref": "#/components/messages/Event"
        }
      },
      "parameters": {
        "event_type": {
          "description": "Validated domain event token"
        },
        "node_code": {
          "description": "Validated source node code"
        }
      }
    },
    "heartbeats": {
      "address": "ogas.heartbeats.{node_code}",
      "messages": {
        "heartbeat": {
          "$ref": "#/components/messages/Heartbeat"
        }
      },
      "parameters": {
        "node_code": {
          "description": "Validated edge node code"
        }
      }
    }
  },
  "components": {
    "messages": {
      "Audit": {
        "name": "Audit",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/TransportEnvelope"
            },
            {
              "properties": {
                "message_type": {
                  "const": "audit"
                }
              },
              "required": [
                "message_type"
              ],
              "type": "object"
            }
          ]
        },
        "title": "Mini-OGAS audit envelope",
        "x-mini-ogas-implementation-status": "contract-defined-not-transactionally-wired"
      },
      "Command": {
        "name": "Command",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/TransportEnvelope"
            },
            {
              "properties": {
                "message_type": {
                  "const": "command"
                }
              },
              "required": [
                "message_type"
              ],
              "type": "object"
            }
          ]
        },
        "title": "Mini-OGAS command envelope",
        "x-mini-ogas-implementation-status": "contract-defined-not-transactionally-wired"
      },
      "Event": {
        "name": "Event",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/TransportEnvelope"
            },
            {
              "properties": {
                "message_type": {
                  "const": "event"
                }
              },
              "required": [
                "message_type"
              ],
              "type": "object"
            }
          ]
        },
        "title": "Mini-OGAS event envelope",
        "x-mini-ogas-implementation-status": "contract-defined-not-transactionally-wired"
      },
      "Heartbeat": {
        "name": "Heartbeat",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/TransportEnvelope"
            },
            {
              "properties": {
                "message_type": {
                  "const": "heartbeat"
                }
              },
              "required": [
                "message_type"
              ],
              "type": "object"
            }
          ]
        },
        "title": "Mini-OGAS heartbeat envelope",
        "x-mini-ogas-implementation-status": "wired-shadow"
      }
    },
    "schemas": {
      "AlarmData": {
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "acknowledged",
              "resolved"
            ],
            "title": "Status",
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Threshold"
          },
          "type": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "title": "Type",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value"
          }
        },
        "required": [
          "type",
          "severity",
          "status"
        ],
        "title": "AlarmData",
        "type": "object"
      },
      "AuditData": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "actor": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Actor",
            "type": "string"
          },
          "detail": {
            "default": "",
            "maxLength": 4096,
            "title": "Detail",
            "type": "string"
          },
          "resource_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Resource Type",
            "type": "string"
          },
          "result": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "actor",
          "action",
          "resource_type",
          "resource_id",
          "result"
