services/central-api/secrets/*.json
!services/central-api/secrets/.gitkeep
services/ai-dispatcher/secrets/*.json
!services/ai-dispatcher/secrets/.gitkeep

# Runtime-generated deployment secrets. Examples stay committed under
# deploy/env.*.example; actual node/edge env files and generated tokens do not.
.env
.env.*
!.env.example
*.env.local
*.env.secret
.env.node
.env.edge
**/.env.node
**/.env.edge
miniogas-token.txt
**/miniogas-token.txt

# Local dependencies, runtime state, and browser-test artifacts.
node_modules/
.runtime/
.playwright-cli/
.playwright-mcp/
output/
*.out.log
*.err.log

# Python local environments and test/runtime caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local databases and generated frontend builds.
*.db
*.sqlite
*.sqlite3
dist/
*.tsbuildinfo

# Local Superpowers brainstorming/session artifacts.
.superpowers/
