*.env.local
*.env.secret
.env.node
.env.edge
**/.env.node
**/.env.edge
miniogas-token.txt
**/miniogas-token.txt
*.pem
*.key
*.pfx
*.p12
id_rsa
id_rsa.*
*credentials*.json
*secret*.json
*vault*.json

