APP_ENV=digital_twin
API_ACCESS_TOKEN=replace_me
AI_DISPATCHER_TOKEN=replace_with_distinct_internal_token
NODE_INGEST_TOKEN=replace_me
ALLOW_LEGACY_NODE_TOKEN_AUTH=false
NODE_CREDENTIALS_JSON={"turning-workshop-01":"replace_turning_node_token_000000000000","milling-workshop-01":"replace_milling_node_token_000000000000","grinding-workshop-01":"replace_grinding_node_token_000000000000"}
PERSIST_ENABLED=true
PERSIST_BACKEND=postgres
DATABASE_AUTO_MIGRATE=false
DATABASE_URL=postgresql://mini_ogas:replace_postgres_password@postgres:5432/mini_ogas?sslmode=disable
HEARTBEAT_SHADOW_RETENTION_PER_NODE=2000
REDIS_ENABLED=true
REDIS_URL=redis://:replace_redis_password@redis:6379/0
NATS_ENABLED=true
NATS_URL=nats://nats:4222
NATS_AUTH_TOKEN=replace_nats_token
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_ACCESS_KEY=miniogas-admin
OBJECT_STORAGE_SECRET_KEY=replace_minio_password
JWT_SECRET=replace_me
MICROSERVICES_ENABLED=true
AI_DISPATCHER_URL=http://ai-dispatcher:8081
MARKET_SIMULATOR_URL=http://market-simulator:8082
PRODUCTION_PLANNER_URL=http://production-planner:8083
BACKGROUND_WORKER_URL=http://background-worker:8084
EXPECTED_PRODUCTION_NODES=turning-workshop-01,milling-workshop-01,grinding-workshop-01
