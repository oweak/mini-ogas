APP_ENV=dev
DATABASE_URL=postgres://mini_ogas:mini_ogas_dev@postgres:5432/mini_ogas?sslmode=disable
REDIS_ADDR=redis:6379
NATS_URL=nats://nats:4222
# ---- AI multi-provider ----
AI_ENABLED=true
AI_TIMEOUT_SECONDS=25
AI_PROVIDER_CHAIN=deepseek,ollama,lm_studio,groq
# DeepSeek (cloud)
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234
# Groq Cloud (free tier)
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
# ---- Auth ----
JWT_SECRET=replace_me
API_ACCESS_TOKEN=replace_me
NODE_INGEST_TOKEN=replace_me
RATE_LIMIT_PER_MINUTE=180
# ---- Microservices ----
MICROSERVICES_ENABLED=true
PERSIST_ENABLED=false
CENTRAL_DB_PATH=.runtime/central.db
AI_DISPATCHER_URL=http://ai-dispatcher:8081
MARKET_SIMULATOR_URL=http://market-simulator:8082
PRODUCTION_PLANNER_URL=http://production-planner:8083
