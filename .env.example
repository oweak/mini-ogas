# Environment boundary. Production rejects simulated data, Demo Seed and dev secrets.
APP_ENV=development
DATA_SOURCE=simulated
CONTROL_MODE=operator_assisted
DEMO_SEED_ENABLED=true
INDUSTRIAL_CONNECTOR_ENABLED=false
PHYSICAL_WRITE_ENABLED=false
TENANT_ID=tenant-local
SITE_ID=site-digital-twin
# Backward-compatible alias used by older helper scripts.
MINI_OGAS_ENV=development
CENTRAL_API_HOST=127.0.0.1
CENTRAL_API_PORT=8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5173
# ---- AI multi-provider settings ----
AI_ENABLED=true
AI_TIMEOUT_SECONDS=60
# Reasoning-capable models can spend part of this budget before producing the final answer.
AI_CHAT_MAX_TOKENS=4096
# Protect paid/live providers from dashboard polling. Manual refresh bypasses this cache.
AI_RULE_EXPLANATION_CACHE_SECONDS=60
# Chain order for fallback: first available wins. Options: deepseek, ollama, lm_studio, groq
AI_PROVIDER_CHAIN=deepseek,ollama,lm_studio,groq
# DeepSeek (cloud)
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b-local
# LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234
# Groq Cloud (free tier)
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
# ---- Auth / rate-limit ----
API_ACCESS_TOKEN=replace_me
NODE_INGEST_TOKEN=replace_me
RATE_LIMIT_PER_MINUTE=180
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# ---- Microservices ----
MICROSERVICES_ENABLED=true
PERSIST_ENABLED=true
PERSIST_BACKEND=postgres
CENTRAL_FACT_SOURCE=postgresql
POSTGRES_DSN=postgresql://miniogas:replace-with-password@127.0.0.1:5432/miniogas
# SQLite is reserved for explicit local/edge fallback and tests.
CENTRAL_DB_PATH=.runtime/central.db
HEARTBEAT_SHADOW_RETENTION_PER_NODE=2000
TELEMETRY_RAW_RETENTION_DAYS=7
TELEMETRY_AGGREGATE_RETENTION_DAYS=90
TELEMETRY_BOOTSTRAP_CATALOG_ENABLED=false
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=miniogas-documents
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_MAX_BYTES=26214400
# ---- NATS v3.0.1 shadow transport ----
# Keep disabled unless a local JetStream server is configured. The canonical
# supervisor enables it and loads the token from D:\MiniOGAS-VMs\nats\nats.env.
NATS_ENABLED=false
NATS_URL=nats://127.0.0.1:4222
NATS_AUTH_TOKEN=replace_me
NATS_STREAM=OGAS_V3_SHADOW
NATS_CONSUMER=ogas-v3-postgres-worker
NATS_CONNECT_TIMEOUT_SECONDS=2
NATS_PUBLISH_TIMEOUT_SECONDS=2
NATS_RETRY_SECONDS=5
NATS_STREAM_MAX_BYTES=4294967296
AI_DISPATCHER_URL=http://127.0.0.1:8081
MARKET_SIMULATOR_URL=http://127.0.0.1:8082
PRODUCTION_PLANNER_URL=http://127.0.0.1:8083
# ---- Node agent ----
NODE_CODE=turning-workshop-01
WORKSHOP_TYPE=turning
CENTRAL_API_URL=http://127.0.0.1:8080
CENTRAL_API_TOKEN=replace_me
