MINI_OGAS_ENV=development
CENTRAL_API_HOST=127.0.0.1
CENTRAL_API_PORT=8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5173
# ---- AI multi-provider settings ----
AI_ENABLED=true
AI_TIMEOUT_SECONDS=60
# Chain order for fallback: first available wins. Options: deepseek, ollama, lm_studio, groq
AI_PROVIDER_CHAIN=deepseek,ollama,lm_studio,groq
# DeepSeek (cloud)
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b-local
# LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234
# Groq Cloud (free tier)
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
# ---- Auth / rate-limit ----
API_ACCESS_TOKEN=replace_me
NODE_INGEST_TOKEN=replace_me
RATE_LIMIT_PER_MINUTE=180
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# ---- Microservices ----
MICROSERVICES_ENABLED=true
PERSIST_ENABLED=true
PERSIST_BACKEND=postgres
CENTRAL_FACT_SOURCE=postgresql
POSTGRES_DSN=postgresql://miniogas:replace-with-password@127.0.0.1:5432/miniogas
# SQLite is reserved for explicit local/edge fallback and tests.
CENTRAL_DB_PATH=.runtime/central.db
HEARTBEAT_SHADOW_RETENTION_PER_NODE=2000
AI_DISPATCHER_URL=http://127.0.0.1:8081
MARKET_SIMULATOR_URL=http://127.0.0.1:8082
PRODUCTION_PLANNER_URL=http://127.0.0.1:8083
# ---- Node agent ----
NODE_CODE=turning-workshop-01
WORKSHOP_TYPE=turning
CENTRAL_API_URL=http://127.0.0.1:8080
CENTRAL_API_TOKEN=replace_me
