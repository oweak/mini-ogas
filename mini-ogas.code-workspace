{
  "folders": [
    {
      "name": "Mini-OGAS",
      "path": "."
    },
    {
      "name": "central-api",
      "path": "services/central-api"
    },
    {
      "name": "dashboard",
      "path": "services/dashboard"
    },
    {
      "name": "node-agent",
      "path": "services/node-agent"
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "python.defaultInterpreterPath": "${workspaceFolder:central-api}/.venv/Scripts/python.exe",
    "python.analysis.typeCheckingMode": "basic",
    "go.goroot": "${workspaceFolder:Mini-OGAS}/.runtime/tools/go",
    "go.gopath": "${workspaceFolder:Mini-OGAS}/.runtime/go",
    "typescript.tsdk": "${workspaceFolder:dashboard}/node_modules/typescript/lib",
    "vue.server.hybridMode": true
  }
}
